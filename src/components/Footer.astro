---
import { site, nav } from '../data/content.js';
---
<footer class="footer">
  <div class="footer__grid">
    <div>
      <h3 class="footer__h">Studio</h3>
      <p>{site.location}</p>
      <p>{site.hours}</p>
      <a href={`mailto:${site.email}`}>{site.email}</a>
    </div>
    <div>
      <h3 class="footer__h">Explore</h3>
      <ul>
        {nav.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </div>
    <div>
      <h3 class="footer__h">Follow</h3>
      <ul>
        {site.social.map((s) => <li><a href={s.href}>{s.label}</a></li>)}
      </ul>
    </div>
    <div class="footer__wed">
      <h3 class="footer__h">In the wedding industry?</h3>
      <p>Scale your wedding business with Wedding Formexa: web design, SEO, automation and marketing tailored for pros.</p>
      <a class="link-arrow" href={site.weddingUrl}>Visit Wedding Formexa</a>
    </div>
  </div>
  <p class="footer__word" data-letters aria-hidden="true">
    <span class="word">{'Formexa'.split('').map((ch) => <span class="ch" data-ch>{ch}</span>)}</span>
  </p>
  <p class="footer__legal">© {new Date().getFullYear()} Formexa Studio. All rights reserved.</p>
</footer>
