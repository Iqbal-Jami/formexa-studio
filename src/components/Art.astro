---
// Small animated illustrations. Colors come from currentColor + CSS vars so each card can theme them.
const { kind = 'web' } = Astro.props;
---
{kind === 'web' && (
  <svg class="art art-web" viewBox="0 0 400 300" fill="none" aria-hidden="true">
    <rect x="20" y="20" width="360" height="260" rx="18" class="a-line" stroke-width="3" />
    <path d="M20 62h360" class="a-line" stroke-width="3" />
    <circle cx="44" cy="41" r="6" class="a-fill-2" /><circle cx="64" cy="41" r="6" class="a-fill-1" /><circle cx="84" cy="41" r="6" class="a-fill-1" />
    <rect class="a-block b1" x="44" y="86" width="190" height="26" rx="8" />
    <rect class="a-block b2" x="44" y="124" width="140" height="14" rx="7" />
    <rect class="a-block b3" x="44" y="148" width="170" height="14" rx="7" />
    <rect class="a-block b4 a-accent" x="44" y="184" width="104" height="38" rx="19" />
    <rect class="a-block b5 a-soft" x="262" y="86" width="94" height="136" rx="14" />
    <circle class="a-block b6 a-accent" cx="309" cy="130" r="22" />
    <rect class="a-block b7" x="44" y="240" width="312" height="10" rx="5" />
  </svg>
)}
{kind === 'seo' && (
  <svg class="art art-seo" viewBox="0 0 400 300" fill="none" aria-hidden="true">
    <path d="M30 270h340M30 270V30" class="a-line" stroke-width="3" stroke-linecap="round" />
    <path d="M30 220l60-30 50 20 70-70 60 28 80-90" class="a-line a-draw" stroke-width="6" stroke-linecap="round" stroke-linejoin="round" pathLength="1" />
    <g class="a-pop">
      <circle cx="290" cy="80" r="44" class="a-accent-stroke" stroke-width="7" />
      <path d="M322 112l36 36" class="a-accent-stroke" stroke-width="9" stroke-linecap="round" />
    </g>
    <g class="a-bars">
      <rect x="62" y="236" width="22" height="34" rx="6" class="a-soft" />
      <rect x="102" y="216" width="22" height="54" rx="6" class="a-soft" />
      <rect x="142" y="196" width="22" height="74" rx="6" class="a-soft" />
      <rect x="182" y="170" width="22" height="100" rx="6" class="a-soft" />
    </g>
  </svg>
)}
{kind === 'grow' && (
  <svg class="art art-grow" viewBox="0 0 400 300" fill="none" aria-hidden="true">
    <circle cx="200" cy="150" r="30" class="a-accent" />
    <circle cx="200" cy="150" r="30" class="a-ring r1 a-accent-stroke" stroke-width="3" />
    <circle cx="200" cy="150" r="30" class="a-ring r2 a-accent-stroke" stroke-width="3" />
    <circle cx="200" cy="150" r="30" class="a-ring r3 a-accent-stroke" stroke-width="3" />
    <g class="a-orbit"><circle cx="200" cy="38" r="10" class="a-fill-2" /></g>
    <g class="a-orbit o2"><circle cx="200" cy="262" r="8" class="a-fill-1" /></g>
  </svg>
)}
{kind === 'auto' && (
  <svg class="art art-auto" viewBox="0 0 400 300" fill="none" aria-hidden="true">
    <path id="p1" d="M70 150H200M200 150L330 70M200 150L330 230" class="a-line" stroke-width="3" stroke-linecap="round" />
    <rect x="30" y="120" width="80" height="60" rx="16" class="a-fill-1" />
    <rect x="160" y="120" width="80" height="60" rx="16" class="a-accent" />
    <rect x="300" y="40" width="70" height="60" rx="16" class="a-fill-1" />
    <rect x="300" y="200" width="70" height="60" rx="16" class="a-fill-1" />
    <circle r="7" class="a-dot d1 a-fill-2"><animateMotion dur="2.4s" repeatCount="indefinite" path="M70 150H200"/></circle>
    <circle r="7" class="a-dot d2 a-fill-2"><animateMotion dur="2.4s" begin="1.2s" repeatCount="indefinite" path="M200 150L335 70"/></circle>
    <circle r="7" class="a-dot d3 a-fill-2"><animateMotion dur="2.4s" begin="1.8s" repeatCount="indefinite" path="M200 150L335 230"/></circle>
  </svg>
)}
